logic:Merge Sort mein array
ko repeatedly two halves
mein divide karte hain,
dono parts ko separately
sort karte hain aur finally
merge karke complete sorted
array banate hain.
#include <iostream>
using namespace std;

void merge(int arr[], int low, int mid, int high) {
    int i = low;
    int j = mid + 1;
    int k = 0;
    int temp[100];

    while (i <= mid && j <= high) {
        if (arr[i] < arr[j]) {
            temp[k] = arr[i];
            i++;
        }
        else {
            temp[k] = arr[j];
            j++;
        }
        k++;
    }

    while (i <= mid) {
        temp[k] = arr[i];
        i++;
        k++;
    }

    while (j <= high) {
        temp[k] = arr[j];
        j++;
        k++;
    }

    for (i = low, k = 0; i <= high; i++, k++) {
        arr[i] = temp[k];
    }
}

void mergeSort(int arr[], int low, int high) {
    if (low < high) {
        int mid = (low + high) / 2;

        mergeSort(arr, low, mid);
        mergeSort(arr, mid + 1, high);

        merge(arr, low, mid, high);
    }
}

int main() {
    int arr[8] = {77, 33, 44, 11, 88, 22, 66, 55};

    mergeSort(arr, 0, 7);

    cout << "Sorted Array: ";

    for (int i = 0; i < 8; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
