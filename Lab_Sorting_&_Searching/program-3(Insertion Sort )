//Insertion Sort 
logic:Insertion Sort mein ek element
ko key banate hain, previous
elements se compare karte hain, 
bade elements ko right shift
karte hain aur key ko uski 
correct position par insert 
kar dete hain
#include <iostream>
using namespace std;

int main() {
    int arr[8] = {77, 33, 44, 11, 88, 22, 66, 55};
    int temp, ptr;

    for (int k = 1; k < 8; k++) {

        temp = arr[k];
        ptr = k - 1;

        while (ptr >= 0 && temp < arr[ptr]) {
            arr[ptr + 1] = arr[ptr];
            ptr--;
        }

        arr[ptr + 1] = temp;
    }

    cout << "Sorted Array: ";

    for (int i = 0; i < 8; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
output:
Sorted Array: 11 22 33 44 55 66 77 88
